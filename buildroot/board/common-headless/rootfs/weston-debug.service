# This will start the kiosk compositor (the unit keeps the name weston, the
# service-bootloader and chromium.service use it)
# Since we don't autostart it we can get away with some stuff
# example from here: https://github.com/Hjdskes/cage/wiki/Starting-Cage-on-boot-with-systemd

[Unit]
Description=Run the kiosk compositor

[Service]
# ready once the wayland socket exists, chromium.service waits for it
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/kiosk-compositor -S wayland-0 --tracing kiosk_compositor=debug,warn
Restart=always
RestartSec=2
# a compositor that keeps failing must not flood the journal
RestartSteps=5
RestartMaxDelaySec=60
User=user
# Log this user with utmp, letting it show up with commands 'w' and
# 'who'. This is needed since we replace (a)getty.
UtmpIdentifier=tty1
UtmpMode=user
# A virtual terminal is needed.
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
# Fail to start if not controlling the virtual terminal.
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal

# Set a custom pam session
PAMName=weston
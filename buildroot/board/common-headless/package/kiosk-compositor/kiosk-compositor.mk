KIOSK_COMPOSITOR_SRC_DIR = $(TOPDIR)/../../kiosk-compositor

KIOSK_COMPOSITOR_VERSION = 0.1.0
KIOSK_COMPOSITOR_SITE = $(KIOSK_COMPOSITOR_SRC_DIR)
KIOSK_COMPOSITOR_SITE_METHOD = local

KIOSK_COMPOSITOR_DEPENDENCIES = host-rustc host-pkgconf seatd libinput \
	libxkbcommon mesa3d udev
KIOSK_COMPOSITOR_CARGO_ENV = \
	CARGO_HOME=$(HOST_DIR)/share/cargo \
	__CARGO_TEST_CHANNEL_OVERRIDE_DO_NOT_USE_THIS="nightly" \
	CARGO_UNSTABLE_TARGET_APPLIES_TO_HOST="true" \
	CARGO_TARGET_APPLIES_TO_HOST="false" \
	CARGO_BUILD_TARGET="$(RUSTC_TARGET_NAME)" \
	CARGO_TARGET_$(call UPPERCASE,$(RUSTC_TARGET_NAME))_LINKER=$(notdir $(TARGET_CROSS))gcc \
	PKG_CONFIG="$(PKG_CONFIG_HOST_BINARY)" \
	PKG_CONFIG_ALLOW_CROSS=1

KIOSK_COMPOSITOR_BIN_DIR = target/$(RUSTC_TARGET_NAME)/release
KIOSK_COMPOSITOR_CARGO_OPTS = \
	--manifest-path=$(KIOSK_COMPOSITOR_SRC_DIR)/Cargo.toml \
	--release \
	--locked

define KIOSK_COMPOSITOR_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(KIOSK_COMPOSITOR_CARGO_ENV) \
		cargo build $(KIOSK_COMPOSITOR_CARGO_OPTS)
endef

define KIOSK_COMPOSITOR_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(KIOSK_COMPOSITOR_SRC_DIR)/$(KIOSK_COMPOSITOR_BIN_DIR)/kiosk-compositor \
		$(TARGET_DIR)/usr/bin/kiosk-compositor
endef

$(eval $(generic-package))
